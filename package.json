{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ATLAS — explorador cartográfico cinematográfico. Rutas según intención, datos honestos.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5176",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist --project-name atlas-explorador --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
